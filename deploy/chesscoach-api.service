[Unit]
Description=ChessCoach API (public cache of chess.com games + Stockfish analysis)
After=network.target

[Service]
User=chesscoach
Group=chesscoach
WorkingDirectory=/opt/chesscoach
ExecStart=/usr/bin/node /opt/chesscoach/server.js
Environment=PORT=3011 HOST=127.0.0.1 DATA_DIR=/var/lib/chesscoach ENGINE_DIR=/opt/chesscoach/engine DEPTH=16 ANALYSE_LATEST=100
Restart=on-failure
RestartSec=3
# Stockfish must never starve the other sites on this server: lowest priority, at most one core, capped memory
Nice=10
CPUQuota=100%
MemoryMax=700M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/chesscoach

[Install]
WantedBy=multi-user.target
